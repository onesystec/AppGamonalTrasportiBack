generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Area {
  EXTRAS_PIAZZA
  DHL
  FARMACIA
  // Vehiculos importados automaticamente desde Velocity Fleet (targa detectada por
  // GPS que todavia no tenia ficha en la app, ver syncVehiclesFromVelocityFleetForActor
  // en vehicle.service.js) - se crean con esta area a proposito, para que se note de
  // un vistazo cuales faltan revisar y completar a mano.
  SIN_ASIGNAR
}

// Grupo operativo/organizacional del usuario dentro de la empresa, independiente del
// campo Area (que clasifica el tipo de registro/vehiculo). Se usa para agrupar la
// lista de Choferes/Usuarios por sucursal o rol societario.
enum Grupo {
  SOCIEDAD
  MILANO_NORD
  MILANO_SUD
  ROMA
  FARMACIA
}

enum Cargo {
  OWNER
  ADMIN
  CHOFER
  // Recursos Humanos: solo gestiona choferes, vehiculos y busta paga; sin acceso a lo financiero.
  RRHH
}

// Sub-rol de un Responsable (cargo ADMIN). Es la etiqueta de su equipo; lo que realmente puede
// ver lo decide User.areasPermitidas, que el Admin marca con checkboxes.
enum ResponsableTipo {
  MILANO_SUD
  MILANO_NORD
}

// Nivel de un chofer. Cada nivel tiene una meta de km mensual (ver Configuracion "metas.km").
enum NivelChofer {
  NOVATO
  MASTER
  SENIOR
}

enum Estado {
  ACTIVO
  INACTIVO
}

enum TipoDocumento {
  CARTA_IDENTITA
  PASSAPORTO
  SOGGIORNO
  PATENTE
  TRADUZIONE_PATENTE
  CODICE_FISCALE
  CONTRATO
  UNILAV
  PERMESSO_TRASPORTO
  TREDICESIMA_QUATTORDICESIMA
  RESPONSIVAS
}

model User {
  id                           String           @id @default(uuid())
  nombre                       String
  apellido                     String
  imagenPerfilKey              String?
  area                         Area
  grupo                        Grupo?
  cargo                        Cargo            @default(CHOFER)
  // Solo Responsables: su equipo y las areas de servicio que puede ver ("dhl-milano", "dhl-roma",
  // "ab-service", "piazza-milano", "piazza-roma", "otros"). Admin (OWNER) ve todo.
  responsableTipo              ResponsableTipo?
  areasPermitidas              String[]         @default([])
  // Nivel del chofer (cualquier usuario que maneja): fija su meta de km.
  nivelChofer                  NivelChofer?
  estado                       Estado           @default(ACTIVO)
  fechaNacimiento              DateTime         @db.Date
  numeroCelular                String
  correoElectronico            String           @unique
  password                     String
  resetPasswordToken           String?
  resetPasswordExpires         DateTime?
  ubicacionLat                 Float?
  ubicacionLng                 Float?
  ubicacionActualizada         DateTime?
  compartirUbicacion           Boolean          @default(false)
  // El chofer autoriza usar el GPS de su celular SOLO como respaldo cuando el GPS del vehiculo
  // (OneSystec) esta bloqueado o caido, y solo durante sus servicios. Ver gpsRespaldo.service.js.
  gpsRespaldoPermitido         Boolean          @default(false)
  gpsRespaldoPermitidoAt       DateTime?
  // El chofer tiene un servicio activo pero el permiso de ubicacion en segundo plano
  // del celular no esta en "Permitir todo el tiempo" (o fue revocado): el tracking en
  // vivo no va a funcionar aunque compartirUbicacion este activo. Lo reporta el propio
  // celular via useLocationSharing cuando el watcher nativo devuelve NOT_AUTHORIZED.
  ubicacionPermisoDenegado     Boolean          @default(false)
  ubicacionPermisoActualizada  DateTime?
  // Reperibilita (choferes Extras Piazza): el chofer se marca "no disponible" para la
  // noche si no quiere aparecer en el listado aunque este libre. Se lee junto con la
  // fecha - si reperibilidadActualizada no es de hoy, el flag quedo de un dia anterior
  // y se ignora (vuelve a "disponible" solo, sin necesidad de un cron que lo resetee).
  reperibilidadNoDisponible    Boolean          @default(false)
  reperibilidadActualizada     DateTime?
  // Vehiculo "habitual" del chofer (lo carga OWNER/ADMIN desde la ficha del chofer) -
  // independiente del vehicleId de cada Record puntual, que sigue siendo el vehiculo
  // real usado en ESE servicio. Sirve para mostrar de un vistazo con que vehiculo sale
  // cada chofer (ver "Reperibilita" en Resumen), sin tener que cruzar dos listas.
  vehiculoAsignadoId           String?
  vehiculoAsignado             Vehiculo?        @relation(fields: [vehiculoAsignadoId], references: [id])
  // Nota manual de un servicio futuro para este chofer (cualquier area) - lo carga
  // OWNER/ADMIN desde "Agregar chofer" en Resumen > Reperibilita, para avisar al equipo
  // antes de que exista un Registro formal (cliente/destino) para esa fecha. Un solo
  // plan activo por chofer, se pisa si se carga uno nuevo; se limpia a mano con
  // "Quitar" una vez que ya no aplica.
  proximoServicioFecha         DateTime?        @db.Date
  proximoServicioNota          String?
  // Datos de contacto que el propio usuario completa desde "Mi perfil" (opcionales).
  direccion                    String?
  contactoEmergenciaNombre     String?
  contactoEmergenciaParentesco String?
  contactoEmergenciaTelefono   String?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  documentos                Documento[]
  bustasPaga                BustaPaga[]             @relation("BustaPagaChofer")
  bustasPagaSubidas         BustaPaga[]             @relation("BustaPagaSubidaPor")
  mancatosComoChofer        MancatoPagamento[]      @relation("MancatoChofer")
  mancatosCreados           MancatoPagamento[]      @relation("MancatoCreadoPor")
  multasComoChofer          Multa[]                 @relation("MultaChofer")
  multasCreadas             Multa[]                 @relation("MultaCreadaPor")
  combustiblesComoChofer    RegistroCombustible[]   @relation("CombustibleChofer")
  combustiblesCreados       RegistroCombustible[]   @relation("CombustibleCreadoPor")
  records                   Record[]
  mantenimientosRegistrados MantenimientoVehiculo[]
  locationPings             LocationPing[]
  pushTokens                PushToken[]
  permisosComoChofer        Permiso[]               @relation("PermisoChofer")
  permisosCreados           Permiso[]               @relation("PermisoCreadoPor")
  permisosRevisados         Permiso[]               @relation("PermisoRevisadoPor")

  @@map("users")
}

// Token de dispositivo (Firebase Cloud Messaging) para mandar notificaciones push al
// celular con la app cerrada - ver pushNotification.service.js. Se registra al iniciar
// sesion en el APK (Capacitor) y se da de baja al cerrar sesion. Un mismo token es
// unico (si el usuario reinstala o entra con otra cuenta desde el mismo celular, el
// upsert lo reasigna al usuario nuevo en vez de duplicar la fila).
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

model Documento {
  id            String        @id @default(uuid())
  usuarioId     String
  usuario       User          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipoDocumento TipoDocumento
  archivoKey    String
  mimeType      String
  fechaScadenza DateTime?     @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("documentos")
}

// Categoria de consumo del vehiculo: con ella se estiman los litros de un servicio (ver config/faltantes.js).
enum CategoriaVehiculo {
  AUTO_FURGONCINO
  H1_L1
  H2_L2
  CASONATO
}

enum EstadoVehiculo {
  DISPONIBLE
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

model Vehiculo {
  id                    String             @id @default(uuid())
  targa                 String             @unique
  modelo                String
  imagenKey             String?
  libretoKey            String?
  assicurazioneKey      String?
  area                  Area
  grupo                 Grupo?
  estado                EstadoVehiculo     @default(DISPONIBLE)
  categoria             CategoriaVehiculo?
  poliza                DateTime?          @db.Date
  rTecnica              DateTime?          @db.Date
  // Kilometraje para el seguimiento de Tagliando (seccion Mecanica): kmActual - kmUltimoMantenimiento
  // se compara contra el intervalo fijo de 20000km para avisar cuando se acerca o vence el service.
  kmUltimoMantenimiento Float?
  kmActual              Float?
  // Permiso ZTL de Milano (electrico, discapacidad, etc.) - si esta en false (default)
  // y el GPS del vehiculo (Velocity Fleet) lo detecta dentro del poligono de Area C, se
  // dispara una alerta (ver computeAreaCAlerts en el front) para evitar una multa.
  autorizadoAreaC       Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  records           Record[]
  mantenimientos    MantenimientoVehiculo[]
  choferesAsignados User[]
  areaCEntries      AreaCEntry[]
  speedingEvents    SpeedingEvent[]
  paradas           ParadaVehiculo[]
  mancatos          MancatoPagamento[]
  multas            Multa[]
  combustibles      RegistroCombustible[]

  @@map("vehiculos")
}

// Un registro liviano por CADA DIA que un vehiculo sin autorizadoAreaC entra al
// poligono de Area C (no un punto GPS continuo, y no una fila por entrada - el Area C
// de Milano se paga por dia completo, ver findTodayEntryForVehicle en
// areaCEntry.model.js). Seccion "Area C" del Mapa: se completa a mano marcando
// pagado=true, con opcionalmente una foto del comprobante subida a R2.
// Retencion (ver AREA_C_ENTRY_RETENTION_DAYS en env.js): solo se poda lo que sigue SIN
// pagar - una vez pagado (con o sin comprobante) queda como registro permanente, igual
// que cualquier otro documento de la app.
model AreaCEntry {
  id             String    @id @default(uuid())
  vehicleId      String
  vehicle        Vehiculo  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // Denormalizado (no solo via la relacion) para no tener que hacer join al listar
  // las alertas - la targa en si no cambia nunca en la practica.
  targa          String
  enteredAt      DateTime  @default(now())
  pagado         Boolean   @default(false)
  paidAt         DateTime?
  comprobanteKey String?
  // "Eliminada" desde el Mapa > Area C. Si era de HOY se conserva la fila (oculta) para
  // que el chequeo automatico (checkAreaCEntries) no la vuelva a crear mientras el
  // vehiculo siga dentro del Area C; las de dias anteriores se borran de verdad.
  descartada     Boolean   @default(false)

  @@index([vehicleId, enteredAt])
  @@map("area_c_entries")
}

// Un registro liviano por CADA VEZ que un vehiculo supera SPEEDING_THRESHOLD_KMH
// (ver env.js) segun el GPS de Velocity Fleet - no un punto GPS continuo, y como mucho
// uno cada SPEEDING_DEDUP_MINUTES por vehiculo (un exceso de velocidad sostenido no
// genera una fila nueva cada 30-60s, se agrupa como el mismo episodio, ver
// checkSpeedingEvents en vehicle.service.js). Alerta comun de la campanita (se puede
// descartar con la X, a diferencia de Area C - esto es un aviso de manejo, no algo con
// un plazo de pago). Retencion (SPEEDING_EVENT_RETENTION_DAYS, default 30): se poda
// sola, no hace falta conservarla de por vida.
model SpeedingEvent {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehiculo @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  targa      String
  speedKmh   Float
  occurredAt DateTime @default(now())

  @@index([vehicleId, occurredAt])
  @@map("speeding_events")
}

// Clasificacion de una parada del vehiculo (ver vehicleStops.service.js). EN_CURSO: el vehiculo
// sigue detenido. SERVICIO: cerca de una parada del servicio o del deposito (carga, descarga,
// espera: es trabajo). COMBUSTIBLE: coincide con un comprobante de combustible. TOLERADA: dura
// menos que la tolerancia. A_REVISAR: el resto, para que la oficina la mire.
enum ParadaClase {
  EN_CURSO
  SERVICIO
  COMBUSTIBLE
  TOLERADA
  A_REVISAR
}

// Una fila por CADA parada del vehiculo durante la jornada declarada de un servicio (no puntos
// GPS: solo el episodio "estuvo detenido de X a Y en este lugar"), calculada con el historial de
// GPS de OneSystec al enviar el chofer sus horas (ver vehicleStops.service.js). Hoy es solo
// informativo: no cambia el pago. Retencion: PARADA_RETENTION_DAYS.
model ParadaVehiculo {
  id                 String      @id @default(uuid())
  vehicleId          String
  vehicle            Vehiculo    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  targa              String
  driverId           String?
  recordId           String?
  startedAt          DateTime
  endedAt            DateTime?
  durationMin        Int         @default(0)
  lat                Float
  lng                Float
  // true si el motor estuvo apagado en algun momento de la parada.
  motorApagado       Boolean     @default(false)
  clase              ParadaClase @default(EN_CURSO)
  motivo             String?
  distanciaServicioM Int?
  // De donde salieron las posiciones: VEHICULO (OneSystec), CELULAR (respaldo) o MIXTO.
  fuente             String      @default("VEHICULO")
  createdAt          DateTime    @default(now())

  @@index([vehicleId, startedAt])
  @@index([startedAt])
  @@index([clase])
  @@map("paradas_vehiculo")
}

// Historial de cada carga de KM en la seccion Mecanica: conserva el registro completo
// aunque los campos "actuales" del Vehiculo se sobreescriban con la lectura siguiente.
model MantenimientoVehiculo {
  id                    String   @id @default(uuid())
  vehiculoId            String
  vehiculo              Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  kmUltimoMantenimiento Float
  kmActual              Float
  usuarioId             String
  usuario               User     @relation(fields: [usuarioId], references: [id])
  createdAt             DateTime @default(now())

  @@index([vehiculoId])
  @@map("mantenimientos_vehiculo")
}

enum RecordStatus {
  CONSEGNATO
  IN_CONSEGNA
  IN_SOSPESO
  RITIRATO
  ANNULLATO
  RISCHEDULATO
}

// Circuito/aplicativo de reparto asignado al servicio (MILANO 1 a MILANO 18).
// Se carga por servicio, no por chofer, para conservar el historial exacto aunque
// el chofer cambie de aplicativo con el tiempo.
enum Aplicativo {
  MILANO_1
  MILANO_2
  MILANO_3
  MILANO_4
  MILANO_5
  MILANO_6
  MILANO_7
  MILANO_8
  MILANO_9
  MILANO_10
  MILANO_11
  MILANO_12
  MILANO_13
  MILANO_14
  MILANO_15
  MILANO_16
  MILANO_17
  MILANO_18
  ROMA_1
  ROMA_2
  ROMA_3
  ROMA_4
  ROMA_5
  ROMA_6
  ROMA_7
  ROMA_8
  ROMA_9
  ROMA_10
}

// Categoria de despacho del servicio (de donde viene el pedido), independiente del
// aplicativo. Se usa tambien para sincronizar contra la hoja de calculo historica.
enum Spedizzione {
  DHL
  AB_SERVICE
  EXTRA_PIAZZA
  EXTRAS_STEFANIA
}

// Sub-clasificacion de los servicios Extra Piazza (Milano vs Roma), para poder
// filtrar/reportar por zona mas adelante. No aplica a DHL/AB_SERVICE.
enum ExtrasPiazzaZona {
  MILANO
  ROMA
}

enum TipoArchivoRecord {
  CMR
  FOTO_ENTREGA
  FACTURA
  COMPROBANTE
  OTRO
}

model Client {
  id        String   @id @default(uuid())
  nombre    String
  createdAt DateTime @default(now())

  records Record[]

  @@map("clients")
}

// Estado de las horas de un servicio: el chofer las envia (PENDIENTE), el responsable las
// aprueba (APROBADAS) o las devuelve con una nota (DEVUELTAS) para que el chofer las corrija.
// Sin estado = el chofer todavia no cargo horas.
enum HorasEstado {
  PENDIENTE
  APROBADAS
  DEVUELTAS
}

model Record {
  id     String       @id @default(uuid())
  estado RecordStatus @default(IN_SOSPESO)

  driverId  String
  driver    User     @relation(fields: [driverId], references: [id])
  vehicleId String
  vehicle   Vehiculo @relation(fields: [vehicleId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])

  fechaServicio DateTime
  eta           DateTime
  // Cuando sale realmente el vehiculo a hacer el servicio (lo carga la oficina). Junto con
  // eta y la duracion de la ruta permite saber que servicio estaba haciendo un vehiculo en un
  // momento dado (ver mancatoMatching.service.js). Null en los servicios historicos.
  fechaRetiro   DateTime?

  descripcion      String
  codigo           String            @unique
  destinazione     String
  ciudad           String?
  aplicativo       Aplicativo?
  spedizzione      Spedizzione?
  extrasPiazzaZona ExtrasPiazzaZona?

  // Clave del sistema origen (ej. fila de una hoja de calculo sincronizada), para
  // poder re-sincronizar sin crear duplicados. Null en servicios cargados a mano.
  origenExternoId     String? @unique
  // true si el ultimo intento de escritura/actualizacion en AppSheet (best-effort,
  // ver appsheetWriteback.service.js) fallo. Separado de origenExternoId==null porque
  // ese null tambien es el estado normal de servicios historicos que nunca debieron
  // sincronizar (cargados a mano antes de que existiera el sync) - este flag solo se
  // toca cuando de verdad se INTENTO escribir en la hoja y no se pudo.
  appsheetSyncFallido Boolean @default(false)

  // Ruta calculada (deposito fijo -> paradas en orden), cacheada para no recalcular
  // en cada lectura. Null si todavia no se calculo o si el servicio de ruteo fallo.
  stops           RecordStop[]
  // Punto de salida del servicio. null = el deposito de siempre (constants/depot.js). Se elige en el
  // formulario del servicio (sugerencias: DHL Milano, AB Service, DHL Roma, o una direccion libre).
  salidaDireccion String?
  salidaLat       Float?
  salidaLng       Float?
  rutaDistanciaKm Float?
  rutaDuracionMin Float?
  rutaGeometria   Json?
  rutaCalculadaAt DateTime?

  // Operativo: visible y editable por el propio CHOFER
  horasDia            Float?
  horasNoche          Float?
  tiempoEspera        Float?
  // Jornada que declara el chofer al cerrar el servicio (ver utils/workHours.js): de
  // inicio/fin/espera/pausa salen horasDia, horasNoche y tiempoEspera. Solo cuentan para el
  // pago cuando el responsable las aprueba (horasEstado = APROBADAS); si no hay horas
  // aprobadas se paga por km. horasDeclaradas guarda lo que envio el chofer tal cual, para
  // poder comparar si el responsable luego lo ajusto.
  horaInicioReal      DateTime?
  horaFinReal         DateTime?
  pausaMin            Int?
  horasEstado         HorasEstado?
  horasEnviadasAt     DateTime?
  horasRevisadasAt    DateTime?
  horasRevisadaPorId  String?
  horasNota           String?
  horasDeclaradas     Json?
  // Cuando se calcularon las paradas del vehiculo para esta jornada (ParadaVehiculo con recordId);
  // null = todavia no se calcularon (o fallo la consulta al GPS).
  paradasCalculadasAt DateTime?
  // El chofer termino sin pasar por el lugar de espera (por ejemplo fue directo a casa): su fin es la
  // hora de llegada. La regla de pago lo topea a lo que habria tardado en volver desde su ultima entrega.
  finFueraDeBase      Boolean      @default(false)
  // Lectura del GPS sobre el final de la jornada (ultimo movimiento del vehiculo, ultima entrega, tiempo
  // de vuelta al lugar de espera y tope). Solo fechas y duraciones: no guarda ubicaciones de fuera de la jornada.
  gpsFin              Json?
  // Estilo de manejo de ESTA jornada (OneSystec, solo el tramo inicio-fin del chofer): km, calidad e
  // incidentes por categoria. El puntaje de cada chofer se arma sumando los de sus servicios. null = pendiente.
  estiloManejo        Json?
  estiloCalculadoAt   DateTime?
  // Estimacion del tiempo del servicio solo con las direcciones (retiro, paradas, retorno) cuando no hay
  // datos de GPS ni del vehiculo ni del celular. Ver rutaEstimada.service.js.
  estimacionRuta      Json?
  comentarios         String?
  kilometrosReales    Float? // KM real cargado por el chofer, para comparar contra "kilometros" (planificado)

  // Economico: oculto para CHOFER, solo OWNER/ADMIN lo ven/editan
  kilometros                 Float?
  precioKm                   Float?
  areaC                      Float?
  costoEspera                Float?
  costoTraforoFrejusBrennero Float?
  peajes                     Float?
  vignetta                   Float?
  costoHotel                 Float?
  // Costos varios sin una columna propia (viaticos, etc.) - entra en el total sin
  // combustible igual que el resto de los costos operativos, ver computeTotals.
  costoOtros                 Float?
  pagoRecibido               Float?
  costoCombustible           Float?
  clienteConfirmado          Boolean @default(false)

  // Declaraciones del chofer sobre gastos del servicio: si no uso peaje de ida/vuelta o no hizo falta
  // cargar combustible, el servicio no queda en rojo por eso (ver utils/faltantes.js).
  sinPeajeIda            Boolean   @default(false)
  sinPeajeVuelta         Boolean   @default(false)
  sinCombustible         Boolean   @default(false)
  // Aviso push al chofer cuando el servicio sigue con faltantes pasadas 24 horas (una sola vez).
  faltantesAvisadoAt     DateTime?
  // Excepcion de la oficina: a este servicio no se le exige nada (con el motivo y quien la puso).
  faltantesExcepcion     Boolean   @default(false)
  faltantesExcepcionNota String?
  faltantesExcepcionPor  String?
  faltantesExcepcionAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Traspaso entre choferes: cuando un chofer no puede terminar un servicio y otro lo termina, el
  // segundo tramo es un servicio aparte (la "continuacion"), con su chofer, su jornada y su pago, enlazado
  // al servicio original. La continuacion no se factura ni cuenta como servicio nuevo: la plata del
  // cliente sigue en el original. traspasoHora = cuando el segundo chofer recibio el paquete.
  servicioOrigenId String?
  servicioOrigen   Record?   @relation("Traspaso", fields: [servicioOrigenId], references: [id], onDelete: Cascade)
  continuaciones   Record[]  @relation("Traspaso")
  traspasoHora     DateTime?

  files        RecordFile[]
  mancatos     MancatoPagamento[]
  combustibles RegistroCombustible[]

  @@index([fechaServicio])
  @@index([driverId])
  @@index([horasEstado])
  @@index([servicioOrigenId])
  @@map("records")
}

model RecordStop {
  id         String    @id @default(uuid())
  recordId   String
  record     Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  orden      Int
  direccion  String
  lat        Float?
  lng        Float?
  geocodedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recordId, orden])
  @@index([recordId])
  @@map("record_stops")
}

// Cache de geocodificacion (Nominatim) por direccion normalizada, compartido entre
// records para no re-geocodificar direcciones repetidas (deposito, almacenes, clientes).
model GeocodeCache {
  id        String   @id @default(uuid())
  queryKey  String   @unique
  direccion String
  lat       Float
  lng       Float
  raw       Json?
  createdAt DateTime @default(now())

  @@map("geocode_cache")
}

model RecordFile {
  id          String            @id @default(uuid())
  recordId    String
  record      Record            @relation(fields: [recordId], references: [id], onDelete: Cascade)
  archivoKey  String
  tipoArchivo TipoArchivoRecord
  createdAt   DateTime          @default(now())

  @@index([recordId])
  @@map("record_files")
}

// Estado del ultimo sync manual con la hoja de AppSheet ("APP GT 1.0"). Una sola
// fila por "source" (hoy solo "appsheet_registros"). El botón de sync en Mi Perfil
// lee esto para mostrar "última sincronización" y para saber desde qué fecha mirar
// filas nuevas sin tener que releer toda la hoja en cada corrida.
model SyncState {
  id              String    @id @default(uuid())
  source          String    @unique
  lastSyncedAt    DateTime?
  lastRowDate     DateTime?
  lastRunCreated  Int       @default(0)
  lastRunSkipped  Int       @default(0)
  lastRunErrors   Int       @default(0)
  lastRunErrorLog Json?
  updatedAt       DateTime  @updatedAt

  @@map("sync_state")
}

// Historial de posiciones GPS del chofer (tracking continuo durante todo su horario
// laboral, ver useLocationSharing en el front) - a diferencia de User.ubicacionLat/Lng
// (que se pisa en cada actualizacion y solo sirve para "donde esta ahora"), esto
// permite reconstruir la ruta real que hizo un dia puntual, aunque sea de semanas atras.
model LocationPing {
  id         String   @id @default(uuid())
  driverId   String
  driver     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())
  // true si el punto vino del GPS de respaldo (OneSystec caido): se guarda sin el filtro de "quieto"
  // para poder medir cuanto tiempo estuvo parado.
  respaldo   Boolean  @default(false)

  @@index([driverId, recordedAt])
  @@map("location_pings")
}

// Conversacion en curso con el bot de Telegram (ver telegramAssistant.service.js) -
// carga de servicios por chat en lenguaje natural. Se guarda en DB (no en memoria del
// proceso) porque Render free se duerme/reinicia entre mensajes - sin esto se perderia
// el hilo de la conversacion a mitad de carga. Una fila por chat (normalmente uno
// solo, el grupo privado configurado en TELEGRAM_ALLOWED_CHAT_ID); se borra sola al
// completarse o cancelarse el servicio, asi el proximo mensaje arranca de cero.
model TelegramDraft {
  id                   String   @id @default(uuid())
  chatId               String   @unique
  // Historial de la conversacion para este borrador: [{role: "user"|"assistant", content}]
  // - se le reenvia entero a Claude en cada mensaje nuevo para que tenga el contexto
  // completo (paradas ya mencionadas, correcciones, etc.), no hace falta parsear "que
  // se sabe hasta ahora" a mano.
  messages             Json
  // Si esta seteado, el servicio ya se creo y esta esperando UNICAMENTE el precio por
  // km como proximo mensaje (no pasa por Claude, se parsea como numero directo) - ver
  // handleIncomingTelegramMessage. Null en el resto de los casos (conversacion normal).
  pendingPriceRecordId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("telegram_drafts")
}

// Como quedo asignado un mancato a un servicio: AUTO (el sistema lo vinculo con certeza),
// SUGERIDO (hay dudas: la oficina debe confirmarlo), CONFIRMADO (la oficina acepto lo que
// propuso el sistema), MANUAL (la oficina lo eligio a mano, o lo dejo sin servicio a
// proposito: "fuera del horario laboral") y EN_ESPERA (todavia no hay ningun servicio que
// concuerde: a menudo el chofer sube el peaje antes de que la oficina cargue el servicio, asi
// que se vuelve a evaluar solo cuando se carga/edita un servicio del vehiculo; si pasa el
// plazo de espera sin servicio, se muestra como "fuera del horario laboral" - ese paso se
// deriva al leer, no se guarda).
enum MancatoAsignacion {
  AUTO
  SUGERIDO
  CONFIRMADO
  MANUAL
  EN_ESPERA
}

// Parte del viaje en la que se paso el peaje: antes o despues de la hora de entrega.
enum MancatoTramo {
  IDA
  VUELTA
}

// Multa/aviso de pago omitido ("mancato pagamento"): el chofer (o un admin) lo registra y
// se puede pagar hasta el dia 15 posterior a la fecha (fecha + 15), como dicen los avisos. El estado
// (Pendiente / Pagado / Vencido) NO se guarda: se deriva de pagado + fechaVencimiento en
// cada consulta, asi no hace falta ningun cron que marque los vencidos. createdAt es el
// momento real en que se subio al sistema (no editable) y fueraDePlazo queda fijo al
// crear: se subio cuando el plazo ya habia vencido.
model MancatoPagamento {
  id                String            @id @default(uuid())
  numero            String            @unique
  targa             String
  vehicleId         String?
  vehicle           Vehiculo?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId          String?
  driver            User?             @relation("MancatoChofer", fields: [driverId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?             @relation("MancatoCreadoPor", fields: [createdById], references: [id], onDelete: SetNull)
  fecha             DateTime          @db.Date
  // Dia y hora exactos del transito (los dice el aviso). "fecha" sigue siendo la que cuenta
  // para el plazo de pago; esta sirve para asignar el mancato al servicio correcto.
  fechaHoraTransito DateTime?
  fechaVencimiento  DateTime          @db.Date
  costo             Decimal           @db.Decimal(10, 2)
  sitioWeb          String?
  fotoKey           String?
  comprobanteKey    String?
  comentarios       String?
  pagado            Boolean           @default(false)
  pagadoAt          DateTime?
  fueraDePlazo      Boolean           @default(false)
  // Servicio al que pertenece este peaje (ver mancatoMatching.service.js).
  recordId          String?
  record            Record?           @relation(fields: [recordId], references: [id], onDelete: SetNull)
  asignacion        MancatoAsignacion @default(EN_ESPERA)
  tramo             MancatoTramo?
  asignacionMotivo  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([pagado, fechaVencimiento])
  @@index([driverId])
  @@index([fecha])
  @@index([recordId])
  @@index([vehicleId, fechaHoraTransito])
  @@index([asignacion])
  @@map("mancato_pagamentos")
}

enum QuienPagaMulta {
  CHOFER_PAGO
  A_DESCONTAR
}

// Multa de transito (verbale) de un vehiculo de la flota, a nombre de un chofer responsable.
// Se carga desde la oficina (OWNER/ADMIN); el chofer solo ve las suyas. Igual que
// MancatoPagamento, el estado (Pendiente / Pagado / Vencido) no se guarda: se deriva de
// pagado + fechaVencimiento. A diferencia de aquel, el vencimiento lo dice el verbale (se
// carga a mano; por defecto recepcion + 60 dias). quienPaga dice si el chofer pago la multa
// el mismo o si la pago la empresa y hay que descontarsela (descontado marca que ya se hizo).
model Multa {
  id                   String         @id @default(uuid())
  numeroVerbale        String         @unique
  targa                String
  vehicleId            String?
  vehicle              Vehiculo?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId             String?
  driver               User?          @relation("MultaChofer", fields: [driverId], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?          @relation("MultaCreadaPor", fields: [createdById], references: [id], onDelete: SetNull)
  // Dia en que se cometio la infraccion (opcional): sirve para saber quien llevaba el
  // vehiculo ese dia, cruzando con Registros.
  fechaInfraccion      DateTime?      @db.Date
  fechaRecepcion       DateTime       @db.Date
  fechaVencimiento     DateTime       @db.Date
  costo                Decimal        @db.Decimal(10, 2)
  quienPaga            QuienPagaMulta
  descontado           Boolean        @default(false)
  descontadoAt         DateTime?
  comentarios          String?
  multaKey             String?
  comprobanteKey       String?
  // Comprobante que sube el chofer cuando la multa la paga el: no la deja pagada, la oficina lo
  // confirma. comprobanteChoferAt marca "enviado y por confirmar" (se borra al confirmar o reabrir).
  comprobanteChoferKey String?
  comprobanteChoferAt  DateTime?
  // Area de servicio a la que se imputa (misma clave que User.areasPermitidas). Sin area, solo la
  // ven los Admin.
  area                 String?
  pagado               Boolean        @default(false)
  pagadoAt             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([pagado, fechaVencimiento])
  @@index([driverId])
  @@index([fechaRecepcion])
  @@index([quienPaga, descontado])
  @@map("multas")
}

enum AreaCombustible {
  DHL_MILANO
  DHL_ROMA
  EXTRAS_PIAZZA_MILANO
  EXTRAS_PIAZZA_ROMA
  AB_SERVICE
  FARMACIA
}

// A que servicio se asigno una carga de combustible. Igual que MancatoAsignacion, pero aca
// EN_ESPERA no vence nunca: una carga sin servicio no es urgente y se asigna sola cuando
// aparece uno que encaje (o la oficina la deja a mano como "sin servicio").
enum CombustibleAsignacion {
  AUTO
  SUGERIDO
  CONFIRMADO
  MANUAL
  EN_ESPERA
}

// Carga de combustible: el chofer sube el comprobante (foto del ticket) con el monto, la
// gasolinera ("metodo") y el area a la que se imputa el gasto. Lo registra el propio chofer
// (o un OWNER/ADMIN a nombre de uno). createdAt es el momento real de registro (no
// editable) y marca la ventana en la que el chofer todavia puede corregirlo.
model RegistroCombustible {
  id               String                @id @default(uuid())
  targa            String
  vehicleId        String?
  vehicle          Vehiculo?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId         String?
  driver           User?                 @relation("CombustibleChofer", fields: [driverId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?                 @relation("CombustibleCreadoPor", fields: [createdById], references: [id], onDelete: SetNull)
  fecha            DateTime              @db.Date
  // Dia y hora exactos de la carga (hora de Roma): sirve para asignarla al servicio correcto.
  fechaHora        DateTime?
  monto            Decimal               @db.Decimal(10, 2)
  metodo           String
  area             AreaCombustible
  comprobanteKey   String?
  // Servicio al que se imputa (ver combustibleMatching.service.js). Un comprobante pertenece a
  // un solo servicio; el costo de combustible del servicio es la suma de sus comprobantes.
  recordId         String?
  record           Record?               @relation(fields: [recordId], references: [id], onDelete: SetNull)
  asignacion       CombustibleAsignacion @default(EN_ESPERA)
  asignacionMotivo String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([fecha])
  @@index([driverId, fecha])
  @@index([area, fecha])
  @@index([recordId])
  @@index([vehicleId, fechaHora])
  @@index([asignacion])
  @@map("registros_combustible")
}

// Calendario del chofer: dias sin servicio que tienen una razon (permiso, enfermedad, vacaciones,
// descanso). Un dia con servicio cuenta como trabajado y uno sin servicio ni permiso aprobado, como
// no trabajado (se calcula al consultar, no se guarda). El chofer solicita el permiso (queda
// PENDIENTE) y la oficina lo aprueba o rechaza; si lo carga la oficina queda APROBADO directamente.
enum PermisoTipo {
  PERMISO
  ENFERMEDAD
  VACACIONES
  OTRO
  // Dia libre que marca la oficina (no lo puede pedir el chofer): no cuenta como falta.
  DESCANSO
}

enum PermisoEstado {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Permiso {
  id       String @id @default(uuid())
  driverId String
  driver   User   @relation("PermisoChofer", fields: [driverId], references: [id], onDelete: Cascade)

  tipo       PermisoTipo   @default(PERMISO)
  fechaDesde DateTime      @db.Date
  fechaHasta DateTime      @db.Date
  motivo     String
  estado     PermisoEstado @default(PENDIENTE)

  // Fecha y hora exactas de la solicitud: la pone el servidor, nunca se edita (para cambiar algo
  // se cancela y se pide de nuevo). Con esto se sabe si el permiso se aviso con anticipacion.
  solicitadoAt DateTime @default(now())
  // Quien lo cargo: el propio chofer, o la oficina en su nombre.
  creadoPorId  String
  creadoPor    User     @relation("PermisoCreadoPor", fields: [creadoPorId], references: [id])

  revisadoAt    DateTime?
  revisadoPorId String?
  revisadoPor   User?     @relation("PermisoRevisadoPor", fields: [revisadoPorId], references: [id])
  respuesta     String?

  @@index([driverId, fechaDesde, fechaHasta])
  @@index([estado])
  @@map("permisos")
}

// Ajustes globales que edita la oficina desde la app (hoy: tope de permisos por dia). clave
// "permisos.maxPorDia" -> { "max": 3 } (max null = sin tope).
model Configuracion {
  clave     String   @id
  valor     Json
  updatedAt DateTime @updatedAt

  @@map("configuracion")
}

// Busta paga (recibo de sueldo) de un chofer, cargada por Recursos Humanos. El PDF vive en el bucket
// privado y solo se abre con URL firmada corta. Para verla, el chofer firma a mano en el celular: la
// firma, la hora del servidor, el dispositivo y la huella (SHA-256) del archivo quedan como comprobante
// de recepcion. Una por chofer y mes; una vez firmada ya no se puede reemplazar.
model BustaPaga {
  id               String    @id @default(uuid())
  choferId         String
  chofer           User      @relation("BustaPagaChofer", fields: [choferId], references: [id], onDelete: Restrict)
  anio             Int
  mes              Int
  archivoKey       String
  archivoHash      String
  nombreArchivo    String?
  subidaPorId      String
  subidaPor        User      @relation("BustaPagaSubidaPor", fields: [subidaPorId], references: [id], onDelete: Restrict)
  firmadaAt        DateTime?
  firmaKey         String?
  firmaIp          String?
  firmaDispositivo String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accesos BustaPagaAcceso[]

  @@unique([choferId, anio, mes])
  @@index([choferId, anio, mes])
  @@map("busta_paga")
}

// Registro de quien hizo que con cada busta paga (subida, firma, vista, descarga, reemplazo).
model BustaPagaAcceso {
  id          String    @id @default(uuid())
  bustaPagaId String
  bustaPaga   BustaPaga @relation(fields: [bustaPagaId], references: [id], onDelete: Cascade)
  usuarioId   String
  accion      String
  ip          String?
  dispositivo String?
  createdAt   DateTime  @default(now())

  @@index([bustaPagaId, createdAt])
  @@map("busta_paga_accesos")
}
