generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Area {
  EXTRAS_PIAZZA
  DHL
  FARMACIA
  // Vehiculos importados automaticamente desde Velocity Fleet (targa detectada por
  // GPS que todavia no tenia ficha en la app, ver syncVehiclesFromVelocityFleetForActor
  // en vehicle.service.js) - se crean con esta area a proposito, para que se note de
  // un vistazo cuales faltan revisar y completar a mano.
  SIN_ASIGNAR
}

// Grupo operativo/organizacional del usuario dentro de la empresa, independiente del
// campo Area (que clasifica el tipo de registro/vehiculo). Se usa para agrupar la
// lista de Choferes/Usuarios por sucursal o rol societario.
enum Grupo {
  SOCIEDAD
  MILANO_NORD
  MILANO_SUD
  ROMA
  FARMACIA
}

enum Cargo {
  OWNER
  ADMIN
  CHOFER
}

enum Estado {
  ACTIVO
  INACTIVO
}

enum TipoDocumento {
  CARTA_IDENTITA
  PASSAPORTO
  SOGGIORNO
  PATENTE
  TRADUZIONE_PATENTE
  CODICE_FISCALE
  CONTRATO
  UNILAV
  PERMESSO_TRASPORTO
  TREDICESIMA_QUATTORDICESIMA
  RESPONSIVAS
}

model User {
  id                   String    @id @default(uuid())
  nombre               String
  apellido             String
  imagenPerfilKey      String?
  area                 Area
  grupo                Grupo?
  cargo                Cargo     @default(CHOFER)
  estado               Estado    @default(ACTIVO)
  fechaNacimiento      DateTime  @db.Date
  numeroCelular        String
  correoElectronico    String    @unique
  password             String
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  ubicacionLat         Float?
  ubicacionLng         Float?
  ubicacionActualizada DateTime?
  compartirUbicacion   Boolean   @default(false)
  // El chofer tiene un servicio activo pero el permiso de ubicacion en segundo plano
  // del celular no esta en "Permitir todo el tiempo" (o fue revocado): el tracking en
  // vivo no va a funcionar aunque compartirUbicacion este activo. Lo reporta el propio
  // celular via useLocationSharing cuando el watcher nativo devuelve NOT_AUTHORIZED.
  ubicacionPermisoDenegado    Boolean   @default(false)
  ubicacionPermisoActualizada DateTime?
  // Reperibilita (choferes Extras Piazza): el chofer se marca "no disponible" para la
  // noche si no quiere aparecer en el listado aunque este libre. Se lee junto con la
  // fecha - si reperibilidadActualizada no es de hoy, el flag quedo de un dia anterior
  // y se ignora (vuelve a "disponible" solo, sin necesidad de un cron que lo resetee).
  reperibilidadNoDisponible   Boolean   @default(false)
  reperibilidadActualizada    DateTime?
  // Vehiculo "habitual" del chofer (lo carga OWNER/ADMIN desde la ficha del chofer) -
  // independiente del vehicleId de cada Record puntual, que sigue siendo el vehiculo
  // real usado en ESE servicio. Sirve para mostrar de un vistazo con que vehiculo sale
  // cada chofer (ver "Reperibilita" en Resumen), sin tener que cruzar dos listas.
  vehiculoAsignadoId   String?
  vehiculoAsignado     Vehiculo? @relation(fields: [vehiculoAsignadoId], references: [id])
  // Nota manual de un servicio futuro para este chofer (cualquier area) - lo carga
  // OWNER/ADMIN desde "Agregar chofer" en Resumen > Reperibilita, para avisar al equipo
  // antes de que exista un Registro formal (cliente/destino) para esa fecha. Un solo
  // plan activo por chofer, se pisa si se carga uno nuevo; se limpia a mano con
  // "Quitar" una vez que ya no aplica.
  proximoServicioFecha DateTime? @db.Date
  proximoServicioNota  String?
  // Datos de contacto que el propio usuario completa desde "Mi perfil" (opcionales).
  direccion                    String?
  contactoEmergenciaNombre     String?
  contactoEmergenciaParentesco String?
  contactoEmergenciaTelefono   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  documentos Documento[]
  mancatosComoChofer MancatoPagamento[] @relation("MancatoChofer")
  mancatosCreados    MancatoPagamento[] @relation("MancatoCreadoPor")
  multasComoChofer   Multa[]            @relation("MultaChofer")
  multasCreadas      Multa[]            @relation("MultaCreadaPor")
  records    Record[]
  mantenimientosRegistrados MantenimientoVehiculo[]
  locationPings LocationPing[]
  pushTokens PushToken[]

  @@map("users")
}

// Token de dispositivo (Firebase Cloud Messaging) para mandar notificaciones push al
// celular con la app cerrada - ver pushNotification.service.js. Se registra al iniciar
// sesion en el APK (Capacitor) y se da de baja al cerrar sesion. Un mismo token es
// unico (si el usuario reinstala o entra con otra cuenta desde el mismo celular, el
// upsert lo reasigna al usuario nuevo en vez de duplicar la fila).
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

model Documento {
  id            String        @id @default(uuid())
  usuarioId     String
  usuario       User          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipoDocumento TipoDocumento
  archivoKey    String
  mimeType      String
  fechaScadenza DateTime?     @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("documentos")
}

enum EstadoVehiculo {
  DISPONIBLE
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

model Vehiculo {
  id               String         @id @default(uuid())
  targa            String         @unique
  modelo           String
  imagenKey        String?
  libretoKey       String?
  assicurazioneKey String?
  area             Area
  grupo            Grupo?
  estado           EstadoVehiculo @default(DISPONIBLE)
  poliza           DateTime?      @db.Date
  rTecnica         DateTime?      @db.Date
  // Kilometraje para el seguimiento de Tagliando (seccion Mecanica): kmActual - kmUltimoMantenimiento
  // se compara contra el intervalo fijo de 20000km para avisar cuando se acerca o vence el service.
  kmUltimoMantenimiento Float?
  kmActual              Float?
  // Permiso ZTL de Milano (electrico, discapacidad, etc.) - si esta en false (default)
  // y el GPS del vehiculo (Velocity Fleet) lo detecta dentro del poligono de Area C, se
  // dispara una alerta (ver computeAreaCAlerts en el front) para evitar una multa.
  autorizadoAreaC  Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  records        Record[]
  mantenimientos MantenimientoVehiculo[]
  choferesAsignados User[]
  areaCEntries      AreaCEntry[]
  speedingEvents    SpeedingEvent[]

  @@map("vehiculos")
  mancatos MancatoPagamento[]
  multas   Multa[]
}

// Un registro liviano por CADA DIA que un vehiculo sin autorizadoAreaC entra al
// poligono de Area C (no un punto GPS continuo, y no una fila por entrada - el Area C
// de Milano se paga por dia completo, ver findTodayEntryForVehicle en
// areaCEntry.model.js). Seccion "Area C" del Mapa: se completa a mano marcando
// pagado=true, con opcionalmente una foto del comprobante subida a R2.
// Retencion (ver AREA_C_ENTRY_RETENTION_DAYS en env.js): solo se poda lo que sigue SIN
// pagar - una vez pagado (con o sin comprobante) queda como registro permanente, igual
// que cualquier otro documento de la app.
model AreaCEntry {
  id             String    @id @default(uuid())
  vehicleId      String
  vehicle        Vehiculo  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // Denormalizado (no solo via la relacion) para no tener que hacer join al listar
  // las alertas - la targa en si no cambia nunca en la practica.
  targa          String
  enteredAt      DateTime  @default(now())
  pagado         Boolean   @default(false)
  paidAt         DateTime?
  comprobanteKey String?
  // "Eliminada" desde el Mapa > Area C. Si era de HOY se conserva la fila (oculta) para
  // que el chequeo automatico (checkAreaCEntries) no la vuelva a crear mientras el
  // vehiculo siga dentro del Area C; las de dias anteriores se borran de verdad.
  descartada     Boolean   @default(false)

  @@index([vehicleId, enteredAt])
  @@map("area_c_entries")
}

// Un registro liviano por CADA VEZ que un vehiculo supera SPEEDING_THRESHOLD_KMH
// (ver env.js) segun el GPS de Velocity Fleet - no un punto GPS continuo, y como mucho
// uno cada SPEEDING_DEDUP_MINUTES por vehiculo (un exceso de velocidad sostenido no
// genera una fila nueva cada 30-60s, se agrupa como el mismo episodio, ver
// checkSpeedingEvents en vehicle.service.js). Alerta comun de la campanita (se puede
// descartar con la X, a diferencia de Area C - esto es un aviso de manejo, no algo con
// un plazo de pago). Retencion (SPEEDING_EVENT_RETENTION_DAYS, default 30): se poda
// sola, no hace falta conservarla de por vida.
model SpeedingEvent {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehiculo @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  targa      String
  speedKmh   Float
  occurredAt DateTime @default(now())

  @@index([vehicleId, occurredAt])
  @@map("speeding_events")
}

// Historial de cada carga de KM en la seccion Mecanica: conserva el registro completo
// aunque los campos "actuales" del Vehiculo se sobreescriban con la lectura siguiente.
model MantenimientoVehiculo {
  id                    String   @id @default(uuid())
  vehiculoId            String
  vehiculo              Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  kmUltimoMantenimiento Float
  kmActual              Float
  usuarioId             String
  usuario               User     @relation(fields: [usuarioId], references: [id])
  createdAt             DateTime @default(now())

  @@index([vehiculoId])
  @@map("mantenimientos_vehiculo")
}

enum RecordStatus {
  CONSEGNATO
  IN_CONSEGNA
  IN_SOSPESO
  RITIRATO
  ANNULLATO
  RISCHEDULATO
}

// Circuito/aplicativo de reparto asignado al servicio (MILANO 1 a MILANO 18).
// Se carga por servicio, no por chofer, para conservar el historial exacto aunque
// el chofer cambie de aplicativo con el tiempo.
enum Aplicativo {
  MILANO_1
  MILANO_2
  MILANO_3
  MILANO_4
  MILANO_5
  MILANO_6
  MILANO_7
  MILANO_8
  MILANO_9
  MILANO_10
  MILANO_11
  MILANO_12
  MILANO_13
  MILANO_14
  MILANO_15
  MILANO_16
  MILANO_17
  MILANO_18
  ROMA_1
  ROMA_2
  ROMA_3
  ROMA_4
  ROMA_5
  ROMA_6
  ROMA_7
  ROMA_8
  ROMA_9
  ROMA_10
}

// Categoria de despacho del servicio (de donde viene el pedido), independiente del
// aplicativo. Se usa tambien para sincronizar contra la hoja de calculo historica.
enum Spedizzione {
  DHL
  AB_SERVICE
  EXTRA_PIAZZA
  EXTRAS_STEFANIA
}

// Sub-clasificacion de los servicios Extra Piazza (Milano vs Roma), para poder
// filtrar/reportar por zona mas adelante. No aplica a DHL/AB_SERVICE.
enum ExtrasPiazzaZona {
  MILANO
  ROMA
}

enum TipoArchivoRecord {
  CMR
  FOTO_ENTREGA
  FACTURA
  COMPROBANTE
  OTRO
}

model Client {
  id        String   @id @default(uuid())
  nombre    String
  createdAt DateTime @default(now())

  records Record[]

  @@map("clients")
}

model Record {
  id     String       @id @default(uuid())
  estado RecordStatus @default(IN_SOSPESO)

  driverId  String
  driver    User     @relation(fields: [driverId], references: [id])
  vehicleId String
  vehicle   Vehiculo @relation(fields: [vehicleId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])

  fechaServicio DateTime
  eta           DateTime

  descripcion  String
  codigo       String       @unique
  destinazione String
  ciudad       String?
  aplicativo   Aplicativo?
  spedizzione  Spedizzione?
  extrasPiazzaZona ExtrasPiazzaZona?

  // Clave del sistema origen (ej. fila de una hoja de calculo sincronizada), para
  // poder re-sincronizar sin crear duplicados. Null en servicios cargados a mano.
  origenExternoId String? @unique
  // true si el ultimo intento de escritura/actualizacion en AppSheet (best-effort,
  // ver appsheetWriteback.service.js) fallo. Separado de origenExternoId==null porque
  // ese null tambien es el estado normal de servicios historicos que nunca debieron
  // sincronizar (cargados a mano antes de que existiera el sync) - este flag solo se
  // toca cuando de verdad se INTENTO escribir en la hoja y no se pudo.
  appsheetSyncFallido Boolean @default(false)

  // Ruta calculada (deposito fijo -> paradas en orden), cacheada para no recalcular
  // en cada lectura. Null si todavia no se calculo o si el servicio de ruteo fallo.
  stops           RecordStop[]
  rutaDistanciaKm Float?
  rutaDuracionMin Float?
  rutaGeometria   Json?
  rutaCalculadaAt DateTime?

  // Operativo: visible y editable por el propio CHOFER
  horasDia         Float?
  horasNoche       Float?
  tiempoEspera     Float?
  comentarios      String?
  kilometrosReales Float? // KM real cargado por el chofer, para comparar contra "kilometros" (planificado)

  // Economico: oculto para CHOFER, solo OWNER/ADMIN lo ven/editan
  kilometros                 Float?
  precioKm                   Float?
  areaC                      Float?
  costoEspera                Float?
  costoTraforoFrejusBrennero Float?
  peajes                     Float?
  vignetta                   Float?
  costoHotel                 Float?
  // Costos varios sin una columna propia (viaticos, etc.) - entra en el total sin
  // combustible igual que el resto de los costos operativos, ver computeTotals.
  costoOtros                 Float?
  pagoRecibido               Float?
  costoCombustible           Float?
  clienteConfirmado          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files RecordFile[]

  @@index([fechaServicio])
  @@index([driverId])
  @@map("records")
}

model RecordStop {
  id         String    @id @default(uuid())
  recordId   String
  record     Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  orden      Int
  direccion  String
  lat        Float?
  lng        Float?
  geocodedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recordId, orden])
  @@index([recordId])
  @@map("record_stops")
}

// Cache de geocodificacion (Nominatim) por direccion normalizada, compartido entre
// records para no re-geocodificar direcciones repetidas (deposito, almacenes, clientes).
model GeocodeCache {
  id        String   @id @default(uuid())
  queryKey  String   @unique
  direccion String
  lat       Float
  lng       Float
  raw       Json?
  createdAt DateTime @default(now())

  @@map("geocode_cache")
}

model RecordFile {
  id          String            @id @default(uuid())
  recordId    String
  record      Record            @relation(fields: [recordId], references: [id], onDelete: Cascade)
  archivoKey  String
  tipoArchivo TipoArchivoRecord
  createdAt   DateTime          @default(now())

  @@index([recordId])
  @@map("record_files")
}

// Estado del ultimo sync manual con la hoja de AppSheet ("APP GT 1.0"). Una sola
// fila por "source" (hoy solo "appsheet_registros"). El botón de sync en Mi Perfil
// lee esto para mostrar "última sincronización" y para saber desde qué fecha mirar
// filas nuevas sin tener que releer toda la hoja en cada corrida.
model SyncState {
  id              String    @id @default(uuid())
  source          String    @unique
  lastSyncedAt    DateTime?
  lastRowDate     DateTime?
  lastRunCreated  Int       @default(0)
  lastRunSkipped  Int       @default(0)
  lastRunErrors   Int       @default(0)
  lastRunErrorLog Json?
  updatedAt       DateTime  @updatedAt

  @@map("sync_state")
}

// Historial de posiciones GPS del chofer (tracking continuo durante todo su horario
// laboral, ver useLocationSharing en el front) - a diferencia de User.ubicacionLat/Lng
// (que se pisa en cada actualizacion y solo sirve para "donde esta ahora"), esto
// permite reconstruir la ruta real que hizo un dia puntual, aunque sea de semanas atras.
model LocationPing {
  id         String   @id @default(uuid())
  driverId   String
  driver     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  @@index([driverId, recordedAt])
  @@map("location_pings")
}

// Conversacion en curso con el bot de Telegram (ver telegramAssistant.service.js) -
// carga de servicios por chat en lenguaje natural. Se guarda en DB (no en memoria del
// proceso) porque Render free se duerme/reinicia entre mensajes - sin esto se perderia
// el hilo de la conversacion a mitad de carga. Una fila por chat (normalmente uno
// solo, el grupo privado configurado en TELEGRAM_ALLOWED_CHAT_ID); se borra sola al
// completarse o cancelarse el servicio, asi el proximo mensaje arranca de cero.
model TelegramDraft {
  id        String   @id @default(uuid())
  chatId    String   @unique
  // Historial de la conversacion para este borrador: [{role: "user"|"assistant", content}]
  // - se le reenvia entero a Claude en cada mensaje nuevo para que tenga el contexto
  // completo (paradas ya mencionadas, correcciones, etc.), no hace falta parsear "que
  // se sabe hasta ahora" a mano.
  messages  Json
  // Si esta seteado, el servicio ya se creo y esta esperando UNICAMENTE el precio por
  // km como proximo mensaje (no pasa por Claude, se parsea como numero directo) - ver
  // handleIncomingTelegramMessage. Null en el resto de los casos (conversacion normal).
  pendingPriceRecordId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("telegram_drafts")
}

// Multa/aviso de pago omitido ("mancato pagamento"): el chofer (o un admin) lo registra y
// se puede pagar hasta el dia 15 posterior a la fecha (fecha + 15), como dicen los avisos. El estado
// (Pendiente / Pagado / Vencido) NO se guarda: se deriva de pagado + fechaVencimiento en
// cada consulta, asi no hace falta ningun cron que marque los vencidos. createdAt es el
// momento real en que se subio al sistema (no editable) y fueraDePlazo queda fijo al
// crear: se subio cuando el plazo ya habia vencido.
model MancatoPagamento {
  id               String    @id @default(uuid())
  numero           String    @unique
  targa            String
  vehicleId        String?
  vehicle          Vehiculo? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId         String?
  driver           User?     @relation("MancatoChofer", fields: [driverId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?     @relation("MancatoCreadoPor", fields: [createdById], references: [id], onDelete: SetNull)
  fecha            DateTime  @db.Date
  fechaVencimiento DateTime  @db.Date
  costo            Decimal   @db.Decimal(10, 2)
  sitioWeb         String?
  fotoKey          String?
  comprobanteKey   String?
  comentarios      String?
  pagado           Boolean   @default(false)
  pagadoAt         DateTime?
  fueraDePlazo     Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([pagado, fechaVencimiento])
  @@index([driverId])
  @@index([fecha])
  @@map("mancato_pagamentos")
}

enum QuienPagaMulta {
  CHOFER_PAGO
  A_DESCONTAR
}

// Multa de transito (verbale) de un vehiculo de la flota, a nombre de un chofer responsable.
// Se carga desde la oficina (OWNER/ADMIN); el chofer solo ve las suyas. Igual que
// MancatoPagamento, el estado (Pendiente / Pagado / Vencido) no se guarda: se deriva de
// pagado + fechaVencimiento. A diferencia de aquel, el vencimiento lo dice el verbale (se
// carga a mano; por defecto recepcion + 60 dias). quienPaga dice si el chofer pago la multa
// el mismo o si la pago la empresa y hay que descontarsela (descontado marca que ya se hizo).
model Multa {
  id               String         @id @default(uuid())
  numeroVerbale    String         @unique
  targa            String
  vehicleId        String?
  vehicle          Vehiculo?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId         String?
  driver           User?          @relation("MultaChofer", fields: [driverId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?          @relation("MultaCreadaPor", fields: [createdById], references: [id], onDelete: SetNull)
  // Dia en que se cometio la infraccion (opcional): sirve para saber quien llevaba el
  // vehiculo ese dia, cruzando con Registros.
  fechaInfraccion  DateTime?      @db.Date
  fechaRecepcion   DateTime       @db.Date
  fechaVencimiento DateTime       @db.Date
  costo            Decimal        @db.Decimal(10, 2)
  quienPaga        QuienPagaMulta
  descontado       Boolean        @default(false)
  descontadoAt     DateTime?
  comentarios      String?
  multaKey         String?
  comprobanteKey   String?
  pagado           Boolean        @default(false)
  pagadoAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([pagado, fechaVencimiento])
  @@index([driverId])
  @@index([fechaRecepcion])
  @@index([quienPaga, descontado])
  @@map("multas")
}
