# Servidor
PORT=4000
NODE_ENV=development

# CORS - origenes permitidos separados por coma (ej: https://app.com,https://admin.app.com)
CORS_ORIGIN=*

# Base de datos - Neon PostgreSQL
# Formato: postgresql://usuario:password@host/db?sslmode=require
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Recuperacion de contrasena
RESET_TOKEN_EXPIRES_MINUTES=30
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Resend (envio de emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL="RegistrosGT <no-reply@tudominio.com>"

# Cloudflare R2 (almacenamiento de documentos, bucket privado)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SIGNED_URL_EXPIRES_SECONDS=900

# Geocodificacion (Google Geocoding API - Google Cloud Console > APIs & Services >
# habilitar "Geocoding API" > Credenciales > crear API key) y ruteo (OSRM, servidor
# publico gratuito)
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org

# GPS de vehiculo (seccion Mapa, Velocity Fleet) - opcional, ver README
VELOCITY_FLEET_REFRESH_TOKEN=

# GPS del celular del chofer: apagado por defecto (la ubicacion sale del GPS del vehiculo,
# Velocity Fleet). Poner true para volver a recibir/mostrar la ubicacion de los celulares.
PHONE_LOCATION_ENABLED=false

# Dias de historial de LocationPing que se conservan (ver README, "Monitoreo y costos")
LOCATION_PING_RETENTION_DAYS=90

# Dias que se conserva un AreaCEntry (alerta de Area C) - ver README, "Monitoreo y costos"
AREA_C_ENTRY_RETENTION_DAYS=3

# Alertas de exceso de velocidad - ver README, "Monitoreo y costos"
SPEEDING_THRESHOLD_KMH=120
SPEEDING_DEDUP_MINUTES=20
SPEEDING_EVENT_RETENTION_DAYS=30

# Notificaciones push al celular (Area C, exceso de velocidad) via Firebase Cloud
# Messaging - opcional, ver README. JSON completo de la cuenta de servicio en una sola
# linea (Firebase Console > Configuracion del proyecto > Cuentas de servicio > Generar
# nueva clave privada)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Carga de servicios por chat de Telegram (ver README) - opcional, los 3 juntos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# API de Anthropic (console.anthropic.com) - cuenta y facturacion separadas de
# cualquier suscripcion de Claude.
ANTHROPIC_API_KEY=
